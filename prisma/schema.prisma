generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Типы поддерживаемых устройств
enum DeviceType {
  CAMERA
  PANEL
}

enum UserRole {
  admin
  installer
  manager
  client
}

model users {
  user_id           Int       @id @default(autoincrement())
  user_name         String?
  phone             String    @unique
  email             String?   @unique
  password          String?
  role_name         UserRole
  avatar_path       String?
  activated_at      DateTime? @default(now())
  email_verified_at DateTime?

  addresses clients_x_addresses[]
}

// 3. Адреса объектов
model addresses {
  address_id   Int    @id @default(autoincrement())
  address_name String @unique @db.VarChar(255) // Физический адрес

  clients clients_x_addresses[]
  devices devices[]
}

// 4. Привязка людей (клиентов) к адресам (Многие-ко-многим)
model clients_x_addresses {
  user_id    Int
  address_id Int

  user    users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  address addresses @relation(fields: [address_id], references: [address_id], onDelete: Cascade)

  @@id([user_id, address_id])
}

// 5. Устройства на объектах (Камеры, Вызывные панели и др.)
model devices {
  device_id   Int        @id @default(autoincrement())
  device_name String
  device_type DeviceType @default(CAMERA)
  ip          String?    @db.VarChar(45)
  port        Int?
  login       String?
  password    String?
  address_id  Int

  address addresses @relation(fields: [address_id], references: [address_id], onDelete: Cascade)
}

// 6. Шаблоны писем
model email_templates {
  template_id Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  subject     String
  body_html   String   @db.Text
  updated_at  DateTime @updatedAt @default(now())
}
