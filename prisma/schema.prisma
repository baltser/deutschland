generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Роли в системе (admin, installer, manager, client)
model roles {
  role_id   Int     @id @default(autoincrement())
  role_name String  @unique
  users     users[]
}

// 2. Все известные системе люди (Сотрудники и Предзаписанные клиенты)
model users {
  user_id      Int       @id @default(autoincrement())
  user_name    String?
  phone        String    @unique
  email        String?   @unique
  password     String?
  role_id      Int
  avatar_path  String?
  activated_at DateTime? @default(now())

  role      roles                 @relation(fields: [role_id], references: [role_id])
  addresses clients_x_addresses[]
}

// 3. Адреса объектов
model addresses {
  address_id   Int    @id @default(autoincrement())
  address_name String @unique @db.VarChar(255) // Физический адрес

  clients clients_x_addresses[]
}

// 4. Привязка людей (клиентов) к адресам (Многие-ко-многим)
model clients_x_addresses {
  user_id    Int
  address_id Int

  user    users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  address addresses @relation(fields: [address_id], references: [address_id], onDelete: Cascade)

  @@id([user_id, address_id])
}

model email_templates {
  template_id Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  subject     String
  body_html   String   @db.Text
  updated_at  DateTime @updatedAt @default(now())
}
