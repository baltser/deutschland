# ==========================================
# DNZ Platform Environment Variables Template
# ==========================================

# Node Environment & Session Security
NODE_ENV=development
NUXT_SESSION_PASSWORD=CHANGEME_SUPER_SECRET_SESSION_PASSWORD_AT_LEAST_32_CHARS

# Database (PostgreSQL)
POSTGRES_USER=dnz_user
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=dnz_db
# Для Docker: @postgres:5432 | Для локального запуска: @localhost:5432
DATABASE_URL="postgresql://dnz_user:CHANGEME_POSTGRES_PASSWORD@postgres:5432/dnz_db?schema=public"

# Redis & BullMQ Queues
# Для Docker: redis | Для локального запуска: localhost
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO S3 Object Storage
# Для Docker: minio | Для локального запуска: localhost
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_PASSWORD
NUXT_MINIO_ENDPOINT=minio
NUXT_MINIO_PORT=9000
NUXT_MINIO_USE_SSL=false
NUXT_MINIO_ACCESS_KEY=minio_admin
NUXT_MINIO_SECRET_KEY=CHANGEME_MINIO_PASSWORD
NUXT_MINIO_BUCKET=dnz-uploads

# SMTP Email Dispatch (BullMQ queue)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGEME_SMTP_PASSWORD
SMTP_FROM="DNZ Platform <noreply@yourdomain.com>"

# Public App URL
NUXT_PUBLIC_APP_URL=http://localhost:3000

# uCaller Flash-Call Authentication Config
UCALLER_SECRET_KEY=CHANGEME_UCALLER_SECRET_KEY
UCALLER_SERVICE_ID=CHANGEME_UCALLER_SERVICE_ID

# System Defaults (Automated Seed Admin)
ADMIN_PHONE="79990000000"
ADMIN_NAME="Administrator"
